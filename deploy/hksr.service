[Unit]
Description=Honkai Star Rail evidence knowledge application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hksr_database
Environment=PYTHONUNBUFFERED=1
Environment=HKSR_PROJECT_DIR=%h/hksr_database
Environment=HKSR_POSTGRES_POOL_MAX=2
Environment=HKSR_POSTGRES_ACQUIRE_TIMEOUT=5
Environment=HKSR_POSTGRES_CONNECT_TIMEOUT=10
Environment=HKSR_POSTGRES_STATEMENT_TIMEOUT_MS=15000
ExecStart=%h/hksr_database/deploy/run-hksr-app.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
